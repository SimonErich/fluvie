---
import '../styles/global.css';
import Backdrop from '../components/Backdrop.astro';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Fluvie — you write widgets, Fluvie shoots the film</title>
  <meta name="description" content="Fluvie is an open-source Dart library that renders a declarative Flutter widget tree to a real MP4. You say what the video is; Fluvie works out when everything happens, frame by frame. Deterministic, headless, MIT.">
  <link rel="icon" type="image/svg+xml" href="/fluvie_logo.svg">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://fluvie.dev">
  <meta property="og:title" content="Fluvie — you write widgets, Fluvie shoots the film">
  <meta property="og:description" content="Open-source video, written in Flutter. A real widget tree goes in, a real MP4 comes out. Deterministic, headless, MIT.">
  <meta property="og:image" content="https://fluvie.dev/og.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Fluvie — you write widgets, Fluvie shoots the film">
  <meta name="twitter:description" content="Open-source video, written in Flutter. A real widget tree goes in, a real MP4 comes out. Deterministic, headless, MIT.">
  <meta name="twitter:image" content="https://fluvie.dev/og.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body>

<div style="font-family:'Manrope',system-ui,sans-serif; color:#0B1020; background:#FFFFFF; overflow-x:hidden; position:relative; --ink:#0B1020; --soft:#51607F; --muted:#5E6B86; --line:#ECEFF7; --line2:#EAEFF8; --acc:#1668E3; --acc2:#36E1FF; --dark:#06070F; --dpanel:#0A0E1C; --dline:rgba(255,255,255,0.1); --dtext:#AEBBD8; --dmut:#6A7796; --grad:linear-gradient(120deg,#36E1FF,#1668E3 60%,#0B3FB0);">

  <Backdrop />

  <slot />

</div>

<script>
  import '../scripts/landing.ts';
</script>

</body>
</html>
