  <!-- ============ 4 · PAYOFF ============ -->
  <section data-section="proof" aria-labelledby="proof-h" style="position:relative; padding:90px 24px 110px;">
    <div style="max-width:1180px; margin:0 auto;">
      <div style="position:relative; border-radius:26px; overflow:hidden; background:radial-gradient(130% 130% at 18% 0%, #16357f, #06070F 70%); padding:60px 44px; box-shadow:0 40px 80px -40px rgba(7,11,24,0.6);">
        <div aria-hidden="true" style="position:absolute; inset:0; background-image:radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1.4px); background-size:24px 24px; mask-image:radial-gradient(120% 90% at 50% 0%, #000, transparent 72%); -webkit-mask-image:radial-gradient(120% 90% at 50% 0%, #000, transparent 72%);"></div>
        <div class="flv-grid-2" style="position:relative; display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:center;">
          <div>
            <span style="display:inline-flex; align-items:center; gap:8px; font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.06em; color:var(--acc2); border:1px solid rgba(54,225,255,0.3); padding:6px 12px; border-radius:30px;"><span aria-hidden="true">[</span> 04 &middot; THE PAYOFF <span aria-hidden="true">]</span></span>
            <h2 id="proof-h" style="font-family:'Sora',sans-serif; font-weight:800; font-size:34px; letter-spacing:-0.02em; line-height:1.1; margin:18px 0 0; color:#fff;">Write one. Render a thousand.</h2>
            <p style="font-size:16.5px; line-height:1.6; color:var(--dtext); margin:16px 0 0;">One template plus a data list renders one video per row. The frame cache keys on content, so an unchanged frame is read, not redrawn. Change one number and only the frames that moved render again.</p>
            <p style="font-family:'Sora',sans-serif; font-weight:700; font-size:18px; color:#fff; margin:22px 0 0; border-left:3px solid var(--acc2); padding-left:14px;">"A thousand data-driven videos, rendered like one."</p>
          </div>
          <!-- one template, one card per row -->
          <div style="border-radius:16px; border:1px solid rgba(255,255,255,0.1); background:rgba(255,255,255,0.04); padding:22px;">
            <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--acc2); margin-bottom:12px;">rows = [ Q1, Q2, Q3, Q4 ]</div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
              <div>
                <div style="aspect-ratio:16/10; border-radius:10px; background:radial-gradient(120% 120% at 50% 35%,#16357f,#06070F); display:flex; align-items:center; justify-content:center;"><span style="font-family:'Sora'; font-weight:800; color:#fff; font-size:16px;">Q1</span></div>
                <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--dmut); margin-top:8px; text-align:center;">$2.4M</div>
              </div>
              <div>
                <div style="aspect-ratio:16/10; border-radius:10px; background:radial-gradient(120% 120% at 50% 35%,#13409a,#06070F); display:flex; align-items:center; justify-content:center;"><span style="font-family:'Sora'; font-weight:800; color:#fff; font-size:16px;">Q2</span></div>
                <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--dmut); margin-top:8px; text-align:center;">$3.1M</div>
              </div>
              <div>
                <div style="aspect-ratio:16/10; border-radius:10px; background:radial-gradient(120% 120% at 50% 35%,#16357f,#06070F); display:flex; align-items:center; justify-content:center;"><span style="font-family:'Sora'; font-weight:800; color:#fff; font-size:16px;">Q3</span></div>
                <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--dmut); margin-top:8px; text-align:center;">$3.0M</div>
              </div>
              <div>
                <div style="aspect-ratio:16/10; border-radius:10px; background:radial-gradient(120% 120% at 50% 35%,#13409a,#06070F); display:flex; align-items:center; justify-content:center;"><span style="font-family:'Sora'; font-weight:800; color:#fff; font-size:16px;">Q4</span></div>
                <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--dmut); margin-top:8px; text-align:center;">$4.2M</div>
              </div>
            </div>
            <p style="margin:16px 0 0; font-size:10.5px; color:var(--dmut);">One template, one row per card. The cache shares the work across renders.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
