  <!-- ============ 2 · THE ONE IDEA ============ -->
  <section data-section="idea" aria-labelledby="idea-h" style="position:relative; padding:130px 24px 90px;">
    <div style="max-width:1180px; margin:0 auto;">
      <div style="max-width:720px;">
        <span style="display:inline-flex; align-items:center; gap:8px; font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.06em; color:var(--acc); border:1px solid var(--line); padding:6px 12px; border-radius:30px; background:#fff;"><span aria-hidden="true" style="color:var(--acc2);">[</span> 02 &middot; THE ONE IDEA <span aria-hidden="true" style="color:var(--acc2);">]</span></span>
        <h2 id="idea-h" class="flv-h2" style="font-family:'Sora',sans-serif; font-weight:800; font-size:40px; letter-spacing:-0.02em; line-height:1.08; margin:18px 0 0;">You bring the what.<br>Fluvie brings the when.</h2>
        <p style="font-size:17.5px; line-height:1.6; color:var(--soft); margin:18px 0 0;">Not a recorder. A renderer. A screen recorder captures whatever happened to be on screen. Fluvie computes every frame from your description, so frame 412 is the same today, tomorrow, and on your teammate's laptop.</p>
      </div>

      <div class="flv-grid-2" style="margin-top:48px; display:grid; grid-template-columns:1fr 1fr; gap:24px; align-items:stretch;">
        <!-- old way -->
        <div style="border-radius:18px; border:1px solid var(--line); background:#fff; padding:28px; box-shadow:0 20px 44px -32px rgba(11,16,32,0.2);">
          <div style="display:flex; align-items:center; gap:9px; margin-bottom:18px;"><span aria-hidden="true" style="display:inline-flex; width:24px; height:24px; align-items:center; justify-content:center; border-radius:7px; background:#FCE9EC; color:#D7415E;">&#10005;</span><span style="font-weight:700; font-size:14px; color:#9aa5bd; text-decoration:line-through;">The stopwatch way</span></div>
          <div style="display:flex; flex-direction:column; gap:9px;">
            <div style="display:flex; align-items:center; gap:10px; font-family:'JetBrains Mono',monospace; font-size:12.5px; color:#8a96b3;"><span style="display:inline-flex; width:30px; height:18px; border-radius:4px; background:#EEF2FB; align-items:center; justify-content:center; font-size:9px; color:#B7C2D8;">0ms</span> title.fadeIn(at: 0)</div>
            <div style="display:flex; align-items:center; gap:10px; font-family:'JetBrains Mono',monospace; font-size:12.5px; color:#8a96b3;"><span style="display:inline-flex; width:30px; height:18px; border-radius:4px; background:#EEF2FB; align-items:center; justify-content:center; font-size:9px; color:#B7C2D8;">650</span> subtitle.show(at: 650)</div>
            <div style="display:flex; align-items:center; gap:10px; font-family:'JetBrains Mono',monospace; font-size:12.5px; color:#8a96b3;"><span style="display:inline-flex; width:30px; height:18px; border-radius:4px; background:#EEF2FB; align-items:center; justify-content:center; font-size:9px; color:#B7C2D8;">900</span> chart.grow(at: 900)</div>
            <div style="display:flex; align-items:center; gap:10px; font-family:'JetBrains Mono',monospace; font-size:12.5px; color:#8a96b3;"><span style="display:inline-flex; width:30px; height:18px; border-radius:4px; background:#FCE9EC; align-items:center; justify-content:center; font-size:9px; color:#D7415E;">?!</span> move one, fix them all</div>
          </div>
        </div>
        <!-- fluvie way -->
        <div style="border-radius:18px; border:1px solid rgba(22,104,227,0.25); background:linear-gradient(180deg,#F7FBFF,#fff); padding:28px; box-shadow:0 24px 50px -30px rgba(22,104,227,0.35);">
          <div style="display:flex; align-items:center; gap:9px; margin-bottom:18px;"><span aria-hidden="true" style="display:inline-flex; width:24px; height:24px; align-items:center; justify-content:center; border-radius:7px; background:#E4F7EE; color:#0E9E6E;">&#10003;</span><span style="font-weight:700; font-size:14px; color:var(--acc);">The Fluvie way</span></div>
          <div style="display:flex; flex-direction:column; gap:9px;">
            <div style="display:flex; align-items:center; gap:10px; font-family:'JetBrains Mono',monospace; font-size:12.5px; color:var(--ink);"><span aria-hidden="true" style="width:5px; height:5px; border-radius:50%; background:var(--acc2);"></span> show the title</div>
            <div style="display:flex; align-items:center; gap:10px; font-family:'JetBrains Mono',monospace; font-size:12.5px; color:var(--ink);"><span aria-hidden="true" style="width:5px; height:5px; border-radius:50%; background:var(--acc2);"></span> after the title lands, float the subtitle</div>
            <div style="display:flex; align-items:center; gap:10px; font-family:'JetBrains Mono',monospace; font-size:12.5px; color:var(--ink);"><span aria-hidden="true" style="width:5px; height:5px; border-radius:50%; background:var(--acc2);"></span> then grow the chart</div>
            <div style="display:flex; align-items:center; gap:10px; font-family:'JetBrains Mono',monospace; font-size:12.5px; color:#0E9E6E; font-weight:600;"><span aria-hidden="true">&#10003;</span> move one, the rest re-flow</div>
          </div>
        </div>
      </div>

      <div class="flv-grid-3" style="margin-top:24px; display:grid; grid-template-columns:repeat(3,1fr); gap:16px;">
        <div style="border-radius:14px; border:1px solid var(--line); background:#fff; padding:20px 22px; transition:transform .25s ease, box-shadow .25s ease, border-color .25s ease;" style-hover="transform:translateY(-3px); box-shadow:0 18px 36px -24px rgba(11,16,32,0.2); border-color:#BFE6FF;"><div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--acc2); margin-bottom:6px;">01</div><div style="font-family:'Sora',sans-serif; font-weight:700; font-size:16px;">Describe, do not direct</div></div>
        <div style="border-radius:14px; border:1px solid var(--line); background:#fff; padding:20px 22px; transition:transform .25s ease, box-shadow .25s ease, border-color .25s ease;" style-hover="transform:translateY(-3px); box-shadow:0 18px 36px -24px rgba(11,16,32,0.2); border-color:#BFE6FF;"><div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--acc2); margin-bottom:6px;">02</div><div style="font-family:'Sora',sans-serif; font-weight:700; font-size:16px;">The frame is the only clock</div></div>
        <div style="border-radius:14px; border:1px solid var(--line); background:#fff; padding:20px 22px; transition:transform .25s ease, box-shadow .25s ease, border-color .25s ease;" style-hover="transform:translateY(-3px); box-shadow:0 18px 36px -24px rgba(11,16,32,0.2); border-color:#BFE6FF;"><div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--acc2); margin-bottom:6px;">03</div><div style="font-family:'Sora',sans-serif; font-weight:700; font-size:16px;">Same input, same film</div></div>
      </div>
    </div>
  </section>

