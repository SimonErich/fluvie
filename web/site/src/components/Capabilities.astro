---
import registry from '../../public/render-capabilities.json';
const rows = [
  ['Formats', 'exportModes'], ['Video codecs', 'videoCodecs'], ['Audio', 'audio'],
  ['Target bitrate', 'targetBitRate'], ['CRF control', 'crf'], ['Encoder presets', 'presets'],
] as const;
const display = (value: boolean | string[]) =>
  typeof value === 'boolean' ? (value ? 'yes' : 'no') : value.join(', ');
---
<details style="margin-top:24px; border:1px solid var(--line); border-radius:14px; padding:16px 20px;">
  <summary style="cursor:pointer; font-weight:600;">Compare the default rendering backends</summary>
  <div style="overflow-x:auto; margin-top:18px;">
    <table style="border-collapse:collapse; width:100%; text-align:left; font-size:14px;">
      <thead><tr><th scope="col" style="padding:10px;">Capability</th>{registry.backends.map((backend) => <th scope="col" style="padding:10px;">{backend.backend}</th>)}</tr></thead>
      <tbody>{rows.map(([label, field]) => <tr><th scope="row" style="padding:10px; border-top:1px solid var(--line);">{label}</th>{registry.backends.map((backend) => <td style="padding:10px; border-top:1px solid var(--line);">{display(backend[field])}</td>)}</tr>)}</tbody>
    </table>
  </div>
  <p style="color:var(--soft); line-height:1.6;">Codec availability and host requirements still depend on your environment. Unsupported requests fail before capture. Custom renderers declare their own capabilities.</p>
  <a href="https://docs.fluvie.dev/reference/render-capabilities/">Read the requirements and regression evidence</a>
</details>
