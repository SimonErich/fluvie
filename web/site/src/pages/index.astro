---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Idea from '../components/Idea.astro';
import Triggers from '../components/Triggers.astro';
import Proof from '../components/Proof.astro';
import Start from '../components/Start.astro';
import Reel from '../components/Reel.astro';
import Crew from '../components/Crew.astro';
import Oss from '../components/Oss.astro';
import Seats from '../components/Seats.astro';
import Ai from '../components/Ai.astro';
import Router from '../components/Router.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Nav />

  <main id="main">
    <Hero />
    <Idea />
    <Triggers />
    <Proof />
    <Start />
    <Reel />
    <Crew />
    <Oss />
    <Seats />
    <Ai />
    <Router />
