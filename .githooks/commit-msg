#!/usr/bin/env bash
# Enforce Conventional Commits on the subject line.
set -euo pipefail

MSG_FILE="$1"
header="$(head -n1 "$MSG_FILE")"

regex='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_.-]+\))?(!)?: .+$'
if [[ ! "$header" =~ $regex ]]; then
  echo "✗ commit message must follow Conventional Commits:"
  echo "    <type>(<scope>): <subject>"
  echo "  types: feat fix docs style refactor perf test build ci chore revert"
  echo "  got:  $header"
  exit 1
fi

if [ "${#header}" -gt 72 ]; then
  echo "⚠ subject is ${#header} chars (>72) — consider shortening."
fi
