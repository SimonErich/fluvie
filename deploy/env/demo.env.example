# =============================================================================
# fluvie-demo  ·  the web demo (deploy/demo.Dockerfile)  ·  BUILD-TIME values
# =============================================================================
# Flutter web has no runtime environment: these are baked into the bundle when
# the image is BUILT, not read when the container starts. So you set them at
# build time, not in a running container.
#
# With docker compose (pass the file so the build args interpolate):
#     docker compose --env-file deploy/env/demo.env \
#       -f deploy/docker-compose.yml build fluvie-demo
#
# Or straight to docker build:
#     docker build -f deploy/demo.Dockerfile \
#       --build-arg FLUVIE_API_URL=https://api.fluvie.dev -t fluvie-demo .
#
# On Dokploy, set these as Build Arguments in the app's build settings.
# =============================================================================

# The render API the browser demo calls. Point it at your public API.
#   local:      http://localhost:8080
#   production: https://api.fluvie.dev
FLUVIE_API_URL=https://api.fluvie.dev
# Optional bearer token the demo sends to the render API. Usually empty: the
# public demo talks to an open or rate-limited API.
FLUVIE_API_TOKEN=
