# =============================================================================
# fluvie-server-docs  ·  the slim docs/MCP server (deploy/server-docs.Dockerfile)
# =============================================================================
# Copy this file and fill it in:
#     cp deploy/env/server-docs.env.example deploy/env/server-docs.env
# This image has no render toolchain: the documentation helper and the MCP docs
# tools work offline, with no required variables. Read at container start.
# =============================================================================

# The render API is off in this image (it carries no Flutter/ffmpeg). Leave it.
FLUVIE_ENABLE_API=false

# --- Optional: render through a remote full server ---------------------------
# Set this to a full Fluvie server to enable MCP build mode (the render/author
# tools forward there). Leave unset for a docs-only endpoint.
# FLUVIE_API_URL=https://api.fluvie.dev
# FLUVIE_API_TOKEN=

# --- Protecting this endpoint ------------------------------------------------
# Bearer token clients must send to the HTTP /mcp endpoint. Recommended for a
# public endpoint; generate one with `openssl rand -hex 32`. Empty = open.
FLUVIE_MCP_TOKEN=

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
# The image bundles the docs corpus here; override only if you mount your own.
FLUVIE_DOCS_DIR=/app/documentation
