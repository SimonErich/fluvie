# =============================================================================
# fluvie-mcp  ·  the MCP server (deploy/mcp.Dockerfile)
# =============================================================================
# Copy this file and fill it in:
#     cp deploy/env/mcp.env.example deploy/env/mcp.env
# The MCP server does not render on its own: it forwards every render to a
# Fluvie render API. Read at container start (runtime).
# =============================================================================

# --- The render API it forwards to -------------------------------------------
# REQUIRED. Base URL of the Fluvie render API the tools call.
#   local compose: http://fluvie-api:8080   (the api service's name on the network)
#   production:    https://api.fluvie.dev
FLUVIE_API_URL=http://fluvie-api:8080
# Bearer token for that API. Set it to the API's API_TOKEN. Leave empty only if
# the API is open (no token).
FLUVIE_API_TOKEN=

# --- Protecting this endpoint ------------------------------------------------
# Bearer token clients must send to use the hosted MCP endpoint. Strongly
# recommended for anything public (mcp.fluvie.dev): generate one with
# `openssl rand -hex 32`. Leave empty for an open endpoint (fine on a private
# network). Claude connects with:
#   claude mcp add --transport http fluvie https://mcp.fluvie.dev/mcp \
#     --header "Authorization: Bearer <this value>"
FLUVIE_MCP_TOKEN=

# --- Server ------------------------------------------------------------------
# Where the HTTP transport binds inside the container.
HOST=0.0.0.0
PORT=8080
