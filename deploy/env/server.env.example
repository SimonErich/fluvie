# =============================================================================
# fluvie-server  ·  the full server (deploy/server.Dockerfile)
# =============================================================================
# Copy this file and fill it in:
#     cp deploy/env/server.env.example deploy/env/server.env
# Only API_TOKEN and CLEANUP_TOKEN are required (the render API is on by default);
# everything else has a sensible default. Generate tokens with: openssl rand -hex 32
# Read at container start (runtime).
# =============================================================================

# --- Features ----------------------------------------------------------------
# Toggle each capability. All default to true. Disable the API for a docs/MCP-only
# server (then API_TOKEN/CLEANUP_TOKEN are not required — but the full image still
# carries the render toolchain; use server-docs.Dockerfile for a slim one).
# FLUVIE_ENABLE_API=true
# FLUVIE_ENABLE_MCP=true
# FLUVIE_ENABLE_DOCS=true
# What the MCP server exposes. `build` adds the render/author tools and needs a
# render backend (this server's API, or FLUVIE_API_URL); `docs` is the doc helper
# only. Defaults to build when a backend is available, else docs.
# values: docs | build
# FLUVIE_MCP_MODE=build
# Bearer token clients must send to the HTTP /mcp endpoint. Strongly recommended
# for anything public; leave empty for an open endpoint on a private network.
FLUVIE_MCP_TOKEN=
# Directory the documentation helper reads markdown from. The image bundles it.
# default: /app/documentation
FLUVIE_DOCS_DIR=/app/documentation
# A remote render API for MCP build mode when this server's own API is disabled.
# FLUVIE_API_URL=https://api.fluvie.dev
# FLUVIE_API_TOKEN=

# --- Server ------------------------------------------------------------------
# Interface to bind. Use 0.0.0.0 inside a container so it is reachable.
HOST=0.0.0.0
# Port the server listens on inside the container.
PORT=8080
# Absolute URL users reach the API at; used to build download links.
#   local: http://localhost:8080   production: https://api.fluvie.dev
PUBLIC_BASE_URL=http://localhost:8080

# --- Authentication (render API) ---------------------------------------------
# REQUIRED when the API is enabled. Bearer token to create renders and read jobs.
API_TOKEN=change-me-api-token
# REQUIRED when the API is enabled. Separate token for the cleanup endpoint.
CLEANUP_TOKEN=change-me-cleanup-token
# Optional HMAC key for signing private download URLs. Derived from API_TOKEN
# when unset; set it to rotate signing independently.
# DOWNLOAD_SIGNING_KEY=
# Browser origins allowed to call the API. Comma-separated, `*` for any, or empty.
#   example: https://demo.fluvie.dev,https://fluvie.dev
CORS_ALLOW_ORIGINS=

# --- Storage -----------------------------------------------------------------
# Where rendered files live. `local` writes to a directory (back it with a
# volume); `s3` uses any S3-compatible bucket (see the S3 block below).
# values: local | s3                      default: local
STORAGE_BACKEND=local
# Directory for the local backend. Mount a volume here to persist renders.
LOCAL_STORAGE_DIR=/data/renders
# Default visibility when a request omits it.
# values: true (public links) | false (signed private links)   default: false
PUBLIC_BY_DEFAULT=false
# How long a rendered file is kept before cleanup removes it. Suffixes: h, d, m.
FILE_TTL=24h
# How long a signed/presigned download URL stays valid.
DOWNLOAD_URL_TTL=15m

# --- S3 storage (only when STORAGE_BACKEND=s3) -------------------------------
# Works with AWS S3, DigitalOcean Spaces, MinIO, Backblaze B2, and similar.
# S3_ENDPOINT=nyc3.digitaloceanspaces.com   # host only; use `minio` with the s3 compose profile
# S3_REGION=us-east-1
# S3_BUCKET=renders
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_USE_SSL=true                            # false for the local MinIO profile
# S3_PATH_STYLE=false                        # true for MinIO and Backblaze B2
# S3_PUBLIC_BASE=https://cdn.example.com     # base URL for public objects (a CDN), optional

# --- Cleanup -----------------------------------------------------------------
# How often the built-in sweep removes expired files. Set 0 to disable it and
# call POST /v1/maintenance/cleanup yourself (see the cron profile).
CLEANUP_INTERVAL=1h

# --- Rendering ---------------------------------------------------------------
# How many renders run at once. Rendering is heavy and the encoder is
# single-threaded, so keep this low unless you have spare CPU.
RENDER_CONCURRENCY=1
# Flutter project that holds the capture harness. The image bundles the gallery
# example app; leave this unless you ship your own project.
RENDER_PROJECT=/app/examples/gallery
# Path to the ffmpeg binary. The image provisions a pinned, checksum-verified
# FFmpeg at build time and resolves it automatically. Set this only to point at
# your own ffmpeg (must be >= 6.0); otherwise leave it unset.
# FFMPEG_PATH=ffmpeg

# --- AI authoring (only for prompt/edit renders) -----------------------------
# Lets POST /v1/renders (and MCP build mode) accept a natural-language prompt or
# edit. Leave the provider key unset to keep prompt rendering OFF (recommended for
# a public server, so it never spends your AI budget). Bring your own key.
# values: claude | gemini | mistral | ollama     default: claude
FLUVIE_AI_PROVIDER=claude
# FLUVIE_AI_MODEL=          # optional model override (e.g. claude-sonnet-4-6)
# ANTHROPIC_API_KEY=        # required for provider=claude
# GEMINI_API_KEY=           # required for provider=gemini
# MISTRAL_API_KEY=          # required for provider=mistral
